{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Proxy REST API & Mobile Scanner WebSockets to FastAPI backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# Proxy all UI routes & static assets to Next.js standalone frontend
	handle {
		reverse_proxy frontend:3000
	}
}
