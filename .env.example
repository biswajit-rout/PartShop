# =========================================================================
# PartShop Local Development Environment Template
# Copy to .env: cp .env.example .env
# =========================================================================

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# PostgreSQL Database Configuration
POSTGRES_USER=partshop_user
POSTGRES_PASSWORD=partshop_secret_change_me
POSTGRES_DB=partshop_db
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_PORT=8001
BACKEND_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^http://(192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.)[0-9.]+:3000$

# Mobile Scanner Wireless LAN Configuration
# Set to your PC's Wi-Fi / Ethernet IPv4 address (e.g. 192.168.1.X) so smartphones on the same Wi-Fi can connect
HOST_LAN_IP=192.168.1.9
