# =========================================================================
# PartShop Production Environment Template
# Copy to .env.prod on your server: cp .env.prod.example .env.prod
# NEVER commit .env.prod to version control!
# =========================================================================

# Edge Reverse Proxy (Caddy)
# - Set to your domain (e.g. pos.yourdomain.com) for automatic Let's Encrypt HTTPS
# - Leave as :80 if testing locally or terminating TLS upstream (e.g. Cloudflare Tunnel)
SITE_ADDRESS=jspdesk.duckdns.org
HTTP_PORT=80
HTTPS_PORT=443

# Frontend Configuration
# Use /api/v1 when Caddy proxies both frontend and API on the same domain (recommended)
NEXT_PUBLIC_API_URL=/api/v1

# Optional pre-built registry images (useful on 1 GB RAM VPS to skip on-server builds)
FRONTEND_IMAGE=partshop-frontend:latest
BACKEND_IMAGE=partshop-backend:latest

# PostgreSQL Database Configuration (REQUIRED - replace before deploying!)
POSTGRES_USER=jspdesk
POSTGRES_PASSWORD=Biswa@1993
POSTGRES_DB=partshop_prod_db

# Backend API Configuration (REQUIRED - generate with: openssl rand -hex 32)
BACKEND_SECRET_KEY=0574d7f23eb84f3e301881881ee5b1cd0a63e4619d0d3ec72c1d441da23b698e
CORS_ORIGINS=https://jspdesk.duckdns.org
CORS_ORIGIN_REGEX=
